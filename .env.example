# Local development database (docker compose up -d)
DATABASE_URL=postgres://cavalieri:cavalieri@localhost:5433/cavalieri

# Staff authentication. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Development only: stand in for the payment step until Stripe keys are configured. Never honoured in production.
ALLOW_SIMULATED_PAYMENTS=true

# Protects the scheduled-jobs endpoint (/api/cron/tick)
CRON_SECRET=change-me

# Public address of the site, used for metadata, the sitemap and structured data
SITE_URL=http://localhost:3000

# Emails. Without RESEND_API_KEY nothing is sent; messages are only recorded in email_log.
RESEND_API_KEY=
EMAIL_FROM="Cavalieri Roof Garden <reservations@example.com>"
# Where the restaurant receives new-reservation, cancellation and no-show emails
RESTAURANT_NOTIFICATION_EMAIL=
